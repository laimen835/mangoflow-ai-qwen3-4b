{
  "name": "spk-cpu-trial",
  "services": {
    "db": {
      "image": "pgvector/pgvector:pg16",
      "environment": {
        "POSTGRES_DB": "rag",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?Generate trial.env first}"
      },
      "volumes": ["./state/postgres:/var/lib/postgresql/data"],
      "restart": "unless-stopped",
      "healthcheck": {"test": ["CMD-SHELL", "pg_isready -U postgres -d rag"], "interval": "5s", "timeout": "3s", "retries": 20}
    },
    "ollama": {
      "image": "ollama/ollama:0.40.13",
      "environment": {"OLLAMA_HOST": "0.0.0.0:11434", "OLLAMA_NO_CLOUD": "1", "OLLAMA_MAX_LOADED_MODELS": "2", "OLLAMA_NUM_PARALLEL": "1"},
      "volumes": ["./state/ollama:/root/.ollama"],
      "restart": "unless-stopped"
    },
    "api": {
      "build": {"context": "../..", "dockerfile": "deploy/cpu-trial/Dockerfile"},
      "environment": {
        "DATABASE_URL": "postgresql+asyncpg://postgres:${POSTGRES_PASSWORD:?Generate trial.env first}@db:5432/rag",
        "ADMIN_API_KEY": "${ADMIN_API_KEY:?Generate trial.env first}",
        "LLM_PROVIDER": "ollama", "LLM_MODEL": "qwen3:4b-instruct",
        "OLLAMA_BASE_URL": "http://ollama:11434", "OPENAI_BASE_URL": "http://ollama:11434/v1", "OPENAI_API_KEY": "ollama",
        "EMBEDDING_PROVIDER": "openai", "EMBEDDING_MODEL": "nomic-embed-text", "EMBEDDING_DIM": "768",
        "LLM_TIMEOUT_S": "240", "LLM_MAX_TOKENS": "500", "OLLAMA_NUM_CTX": "4096",
        "TOP_K_FINAL": "4", "RETRIEVAL_POLICY": "profile", "ANSWER_MODE": "generative", "ANSWER_REVIEW_ENABLED": "false",
        "AUTO_SYNC_ENABLED": "false", "RAW_DIR": "/app/data/raw", "STORAGE_DIR": "/app/data/storage", "TESSERACT_CMD": "/usr/bin/tesseract"
      },
      "ports": ["127.0.0.1:8000:8000"],
      "volumes": ["./state/data:/app/data", "./state/logs:/app/logs"],
      "depends_on": {"db": {"condition": "service_healthy"}, "ollama": {"condition": "service_started"}},
      "restart": "unless-stopped"
    }
  }
}
